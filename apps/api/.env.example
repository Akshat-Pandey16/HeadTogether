APP_NAME=HeadTogether
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./headtogether.db
DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

PASSWORD_MIN_ZXCVBN_SCORE=3
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute

PUBLIC_APP_URL=http://localhost:5173

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
LOG_JSON=false
