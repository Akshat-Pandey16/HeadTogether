APP_NAME=HeadTogether
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./headtogether.db
DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_DAYS=14

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_SEND_MESSAGE=30/minute

# Required when APP_ENV=production (broker, presence and rate-limit storage).
REDIS_URL=redis://127.0.0.1:6379/0
PRESENCE_TTL_SECONDS=30
TYPING_TTL_SECONDS=8
WS_HEARTBEAT_INTERVAL_SECONDS=20
MESSAGE_EDIT_WINDOW_MINUTES=15

# Set to the number of trusted reverse proxies in front of the app so the real
# client IP is read from X-Forwarded-For. Leave 0 when exposed directly.
TRUSTED_PROXY_COUNT=0

PUBLIC_APP_URL=http://localhost:5173

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
LOG_JSON=false
